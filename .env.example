# ---- Supabase (Database + attachment storage) ----
# Create a FREE project at https://supabase.com, then: Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key (server-side only, full access). Keep secret. Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Admin bootstrap + team login ----
# APP_PASSWORD is only used ONCE, for the very first sign-in: enter any email
# + this password to create the admin account. Invite teammates in-app after,
# then REMOVE APP_PASSWORD from the environment.
APP_PASSWORD=change-me-to-a-strong-password
# Optional: lock first-time admin bootstrap to a specific email.
ADMIN_EMAIL=
# Optional: used by `npm run create-admin` (with no args) to create/reset the
# admin account directly — no APP_PASSWORD bootstrap needed.
ADMIN_PASSWORD=

# Random secret used to sign the session cookie (>= 32 chars). Generate with:
#   openssl rand -hex 32
# Rotating this immediately invalidates every active session.
AUTH_SECRET=generate-a-long-random-string

# ---- Cron protection (optional, for the daily due-date reminder job) ----
# Cloud Scheduler sends this as `Authorization: Bearer <value>`.
CRON_SECRET=generate-a-random-string

# ---- Browser push notifications (optional) ----
# Generate once:  node -e "const w=require('web-push');console.log(w.generateVAPIDKeys())"
# The public key is embedded in the browser; the private key stays server-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- Meeting recordings → Google Drive (optional) ----
# A service account (no OAuth): create one in Google Cloud Console, enable the
# Drive API, download its JSON key and paste it here as ONE line. Then create a
# Shared Drive, add the service account's e-mail as Content manager, and put the
# drive's id (from its URL) below. Without these the Record button stays hidden.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_ID=
